{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chairforce/product-filters",
  "version": "1.0.0",
  "title": "Product Filters",
  "category": "theme",
  "description": "Dynamic filter bar, panel, and chips on product archives.",
  "keywords": [
    "filters",
    "shop",
    "woocommerce",
    "archive"
  ],
  "textdomain": "chairforce",
  "attributes": {
    "part": {
      "type": "string",
      "default": "chrome",
      "enum": [
        "chrome",
        "sidebar"
      ]
    },
    "title": {
      "type": "string",
      "default": "Product filters"
    },
    "description": {
      "type": "string",
      "default": "Filter bar, panel, and chips are rendered from PHP on the storefront."
    },
    "links": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "html": false,
    "inserter": false,
    "reusable": false,
    "lock": false,
    "multiple": true
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}