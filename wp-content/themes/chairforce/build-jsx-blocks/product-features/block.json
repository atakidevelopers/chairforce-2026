{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "chairforce/product-features",
  "version": "1.0.0",
  "title": "Product Features",
  "category": "woocommerce",
  "description": "Feature taxonomy icons for the current product (single-product template).",
  "keywords": [
    "woocommerce",
    "product",
    "features",
    "icons",
    "taxonomy"
  ],
  "textdomain": "chairforce",
  "usesContext": [
    "postId"
  ],
  "supports": {
    "html": false,
    "inserter": true,
    "reusable": false,
    "lock": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}