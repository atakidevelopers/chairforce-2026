{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chairforce/testimonials-carousel",
	"version": "1.0.0",
	"title": "Testimonials Carousel",
	"category": "widgets",
	"description": "Displays curated customer testimonials in a carousel.",
	"keywords": ["testimonial", "review", "carousel", "slider", "customer"],
	"textdomain": "chairforce",
	"icon": "format-quote",
	"supports": {
		"html": false,
		"anchor": true,
		"reusable": true,
		"align": ["wide", "full"],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
